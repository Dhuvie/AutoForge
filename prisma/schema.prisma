

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("owner")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projects  Project[]
}

model Project {
  id          String       @id @default(cuid())
  name        String
  description String?
  status      String       @default("active")
  taskType    String?
  ownerId     String?
  owner       User?        @relation(fields: [ownerId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  datasets    Dataset[]
  experiments Experiment[]
  models      ModelRecord[]
  deployments Deployment[]
}

model Dataset {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filename     String
  rowCount     Int
  colCount     Int
  targetColumn String?
  taskType     String?
  schema       String
  profile      String
  headRows     String
  createdAt    DateTime @default(now())
}

model Experiment {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  datasetId   String
  name        String
  status      String   @default("pending")
  taskType    String
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  config      String
  results     String?
}

model ModelRecord {
  id           String       @id @default(cuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  experimentId String
  name         String
  family       String
  taskType     String
  primaryScore Float
  secondaryScore Float?
  cvStd        Float?
  trainTimeMs  Int
  params       String
  metrics      String
  isWinner     Boolean      @default(false)
  isEnsemble   Boolean      @default(false)
  createdAt    DateTime     @default(now())
  deployments  Deployment[]
}

model Deployment {
  id         String      @id @default(cuid())
  projectId  String
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  modelId    String
  model      ModelRecord @relation(fields: [modelId], references: [id], onDelete: Cascade)
  endpoint   String
  status     String      @default("deployed")
  apiKey     String
  createdAt  DateTime    @default(now())
}
